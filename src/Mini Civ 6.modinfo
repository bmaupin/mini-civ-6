<?xml version="1.0" encoding="utf-8"?>
<Mod id="92ea96c4-bbdd-4926-af62-a688aa5b9e1a" version="0">
    <Properties>
        <Name>Mini Civ 6</Name>
        <Teaser>TODO</Teaser>
        <Description>TODO</Description>
        <Authors>bmaupin</Authors>
        <!-- Compatible with the latest build of the game -->
        <CompatibleVersions>2.0</CompatibleVersions>
    </Properties>
    <ActionCriteria>
        <Criteria id="MiniCivVI_CivRev_Ruleset">
            <RuleSetInUse>RULESET_MC6_CIVREV</RuleSetInUse>
        </Criteria>
        <!-- This criteria only matches on standard games (with or without expansions), not scenarios, etc. -->
        <Criteria id="MiniCivVI_Standard_Ruleset">
            <RuleSetInUse>RULESET_STANDARD,RULESET_EXPANSION_1,RULESET_EXPANSION_2</RuleSetInUse>
        </Criteria>
        <Criteria id="MiniCivVI_Standard_Or_CivRev_Ruleset">
            <RuleSetInUse>RULESET_MC6_CIVREV,RULESET_STANDARD,RULESET_EXPANSION_1,RULESET_EXPANSION_2</RuleSetInUse>
        </Criteria>
        <Criteria id="MiniCivVI_Automate_Improvements">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_AUTO_IMPROVEMENTS</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCiv6_Economic_Victory">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>VICTORY_CIVREV_ECONOMIC</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_Amenities">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_NO_AMENITIES</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_Builders">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_NO_BUILDERS</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_City_States">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>CITY_STATE_COUNT</ConfigurationId>
                <Value>0</Value>
            </ConfigurationValueMatches>
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>GAMEMODE_BARBARIAN_CLANS</ConfigurationId>
                <Value>0</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_Espionage">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_NO_ESPIONAGE</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_Great_People">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_NO_GREAT_PEOPLE</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_Military">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_NO_MILITARY</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_Policies">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_NO_POLICIES</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_No_Religion">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_NO_RELIGION</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="MiniCivVI_Remove_Districts">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MC6_REMOVE_DISTRICTS</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
    </ActionCriteria>
    <!-- This is where anything modifying data under Assets/Configuration/ goes -->
    <FrontEndActions>
        <UpdateDatabase id="MiniCivVISettings">
            <File>Data/MiniCivVI_Config.xml</File>
            <File>Data/MiniCivVI_CivRev_Config.xml</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVIConfigFrontendHacks">
            <Criteria>MiniCivVI_Automate_Improvements</Criteria>
            <File>Data/MiniCivVI_ConfigFrontendHacks.sql</File>
        </UpdateDatabase>
        <UpdateText id="MiniCivVISettingsText">
            <File>Text/en_US/MiniCivVI_ConfigText.xml</File>
        </UpdateText>
        <UpdateText id="SumeriaScenarioText">
            <File>Scenarios/Sumeria/Text/en_US/SumeriaScenario_ConfigText.xml</File>
        </UpdateText>
        <AddMap id="SumeriaScenarioMap">
            <Properties>
                <Group>SumeriaScenario_Maps</Group>
                <Name>LOC_MOD_SUMERIASCENARIO_MAP_NAME</Name>
            </Properties>
            <File>Scenarios/Sumeria/Map/Sumeria.Civ6Map</File>
        </AddMap>
        <UpdateDatabase id="SumeriaScenarioSettings">
            <File>Scenarios/Sumeria/Data/SumeriaScenario_Config.xml</File>
        </UpdateDatabase>
    </FrontEndActions>
    <!-- This is where anything modifying data under Assets/Gameplay/ goes -->
    <InGameActions>
        <!-- Custom player domains do not activate the stock DLC leader criteria. -->
        <None id="SumeriaScenarioIncludes" criteria="MiniCivVI_Sumeria_Ruleset">
            <!-- Babylon and its Gathering Storm compatibility data -->
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonGameplay" required="1" />
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonGameplay_XP2" required="1" />
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonArt" required="1" />
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonAudio" required="1" />
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonARX" required="1" />
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonColors" required="1" />
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonIcons" required="1" />
            <Include mod_id="8424840C-92EF-4426-A9B4-B4E0CB818049" action_id="BabylonText" required="1" />
            <!-- Persia is bundled with Macedonia. -->
            <Include mod_id="E2749E9A-8056-45CD-901B-C368C8E83DEB" action_id="MacedoniaGameplay_XP2" required="1" />
            <Include mod_id="E2749E9A-8056-45CD-901B-C368C8E83DEB" action_id="MacedoniaArt" required="1" />
            <Include mod_id="E2749E9A-8056-45CD-901B-C368C8E83DEB" action_id="MacedoniaAudio" required="1" />
            <Include mod_id="E2749E9A-8056-45CD-901B-C368C8E83DEB" action_id="MacedoniaARX" required="1" />
            <Include mod_id="E2749E9A-8056-45CD-901B-C368C8E83DEB" action_id="MacedoniaColors" required="1" />
            <Include mod_id="E2749E9A-8056-45CD-901B-C368C8E83DEB" action_id="MacedoniaGameplayIcons" required="1" />
            <Include mod_id="E2749E9A-8056-45CD-901B-C368C8E83DEB" action_id="MacedoniaText" required="1" />
            <!-- Georgia is bundled with the Rise and Fall major civilisations. -->
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_MajorContent" required="1" />
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_XP2" required="1" />
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_MajorArt" required="1" />
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_MajorAudio" required="1" />
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_MajorARX" required="1" />
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_PlayerColors" required="1" />
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_MajorIcons" required="1" />
            <Include mod_id="1B28771A-C749-434B-9053-D1380C553DE9" action_id="Expansion1_MajorText" required="1" />
        </None>
        <!-- <AddGameplayScripts id="MiniCivVIAutoplay">
            <File>Scripts/Autoplay.lua</File>
        </AddGameplayScripts> -->
        <AddGameplayScripts id="MiniCivVIAutomateImprovementsScripts">
            <Criteria>MiniCivVI_Automate_Improvements</Criteria>
            <File>Scripts/AutomateImprovements.lua</File>
        </AddGameplayScripts>
        <AddGameplayScripts id="MiniCiv6_Economic_Victory_Scripts">
            <Criteria>MiniCiv6_Economic_Victory</Criteria>
            <File>Scripts/MiniCiv6_CivRev_Victories.lua</File>
        </AddGameplayScripts>
        <AddUserInterfaces id="MiniCivVICivRevUILogic">
            <Properties>
                <Context>InGame</Context>
            </Properties>
            <Criteria>MiniCivVI_CivRev_Ruleset</Criteria>
            <File>UI/MiniCivVI_CivRev_UILogic.xml</File>
        </AddUserInterfaces>
        <ReplaceUIScript id="MiniCivVIDisableBoostPopups">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>1000001</LoadOrder>
                <LuaContext>BoostUnlockedPopup</LuaContext>
                <LuaReplace>UI/Replacements/BoostUnlockedPopup_Disabled.lua</LuaReplace>
            </Properties>
        </ReplaceUIScript>
        <ReplaceUIScript id="MiniCivVIDisableGovernmentPolicyButton">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>1000001</LoadOrder>
                <LuaContext>GovernmentScreen</LuaContext>
                <LuaReplace>UI/Replacements/GovernmentScreen_MiniCivVI.lua</LuaReplace>
            </Properties>
            <Criteria>MiniCivVI_No_Policies</Criteria>
        </ReplaceUIScript>
        <ReplaceUIScript id="MiniCivVIDisablePopupPolicyButton">
            <Properties>
                <Context>InGame</Context>
                <LoadOrder>1000001</LoadOrder>
                <LuaContext>TechCivicCompletedPopup</LuaContext>
                <LuaReplace>UI/Replacements/TechCivicCompletedPopup_MiniCivVI.lua</LuaReplace>
            </Properties>
            <Criteria>MiniCivVI_No_Policies</Criteria>
        </ReplaceUIScript>
        <ReplaceUIScript id="MiniCivVICivRevWorldRankings">
            <Properties>
                <LuaContext>WorldRankings</LuaContext>
                <LuaReplace>UI/Replacements/WorldRankings_CivRev.lua</LuaReplace>
            </Properties>
            <Criteria>MiniCivVI_CivRev_Ruleset</Criteria>
        </ReplaceUIScript>
        <UpdateArt id="MiniCivVIUpdateArt">
            <File>MiniCivVI.dep</File>
        </UpdateArt>
        <UpdateDatabase id="MiniCivVICleanupPrep">
            <!-- Load this before everything else -->
            <Properties>
                <LoadOrder>1000000</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_Standard_Or_CivRev_Ruleset</Criteria>
            <File>Data/MiniCivVI_CleanupPrep.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVICivRev">
            <Properties>
                <LoadOrder>2000000</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_CivRev_Ruleset</Criteria>
            <File>Data/MiniCivVI_LessOfEverything.sql</File>
            <File>Data/MiniCivVI_CivRev.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVIAutomateImprovementsDatabase">
            <Properties>
                <!-- This is needed so that this file will be loaded after DLC, otherwise DLC that make changes to removed systems will break -->
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_Automate_Improvements</Criteria>
            <File>Data/MiniCivVI_AutomateImprovements.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoMilitary">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_Military</Criteria>
            <File>Data/MiniCivVI_RemoveMilitary.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVICleanup">
            <!-- Load this after everything else -->
            <Properties>
                <LoadOrder>9999999</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_Standard_Or_CivRev_Ruleset</Criteria>
            <File>Data/MiniCivVI_Cleanup.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVIConfigDataHacks">
            <Criteria>MiniCivVI_Standard_Ruleset</Criteria>
            <File>Data/MiniCivVI_ConfigDataHacks.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVIMiscChanges">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_Standard_Ruleset</Criteria>
            <File>Data/CVI_BarbDiff_LOW.SQL</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoAmenities">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_Amenities</Criteria>
            <File>Data/MiniCivVI_RemoveAmenities.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoBuilders">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_Builders</Criteria>
            <File>Data/MiniCivVI_RemoveBuilders.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoCityStates">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_City_States</Criteria>
            <File>Data/MiniCivVI_RemoveCityStates.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoEspionage">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_Espionage</Criteria>
            <File>Data/MiniCivVI_RemoveEspionage.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoGreatPeople">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_Great_People</Criteria>
            <File>Data/MiniCivVI_RemoveGreatPeople.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoPolicies">
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_Policies</Criteria>
            <File>Data/MiniCivVI_RemovePolicyCards.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVINoReligion">
            <!-- This is needed so that this file will be loaded after DLC, otherwise DLC that make changes to religion will break after religion has been removed -->
            <Properties>
                <LoadOrder>1000001</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_No_Religion</Criteria>
            <File>Data/MiniCivVI_RemoveReligion.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVIRemoveDistricts">
            <Properties>
                <!-- This needs to happen after other changes, otherwise it messes up other options that rely on district prerequisites for changing game data -->
                <LoadOrder>3000000</LoadOrder>
            </Properties>
            <Criteria>MiniCivVI_Remove_Districts</Criteria>
            <File>Data/MiniCivVI_RemoveDistricts.sql</File>
        </UpdateDatabase>
        <UpdateDatabase id="MiniCivVISmallerMaps">
            <File>Data/MiniCivVI_SmallerMaps.sql</File>
        </UpdateDatabase>
        <UpdateIcons id="MiniCivVIConfigIconsHacks">
            <Criteria>MiniCivVI_Standard_Ruleset</Criteria>
            <File>Data/MiniCivVI_ConfigIconHacks.sql</File>
        </UpdateIcons>
        <UpdateText id="MiniCivVI_CivRev_Text">
            <Criteria>MiniCivVI_CivRev_Ruleset</Criteria>
            <File>Text/MiniCivVI_CivRev_Text.sql</File>
        </UpdateText>
    </InGameActions>
    <Files>
        <File>ArtDefs/Camera.artdef</File>
        <File>Data/CVI_BarbDiff_LOW.SQL</File>
        <File>Data/MiniCivVI_AutomateImprovements.sql</File>
        <File>Data/MiniCivVI_CivRev.sql</File>
        <File>Data/MiniCivVI_CivRev_Config.xml</File>
        <File>Data/MiniCivVI_CleanupPrep.sql</File>
        <File>Data/MiniCivVI_Cleanup.sql</File>
        <File>Data/MiniCivVI_Config.xml</File>
        <File>Data/MiniCivVI_ConfigFrontendHacks.sql</File>
        <File>Data/MiniCivVI_ConfigDataHacks.sql</File>
        <File>Data/MiniCivVI_ConfigIconHacks.sql</File>
        <File>Data/MiniCivVI_LessOfEverything.sql</File>
        <File>Data/MiniCivVI_RemoveAmenities.sql</File>
        <File>Data/MiniCivVI_RemoveBuilders.sql</File>
        <File>Data/MiniCivVI_RemoveCityStates.sql</File>
        <File>Data/MiniCivVI_RemoveDistricts.sql</File>
        <File>Data/MiniCivVI_RemoveEspionage.sql</File>
        <File>Data/MiniCivVI_RemoveGreatPeople.sql</File>
        <File>Data/MiniCivVI_RemoveMilitary.sql</File>
        <File>Data/MiniCivVI_RemovePolicyCards.sql</File>
        <File>Data/MiniCivVI_RemoveReligion.sql</File>
        <File>Data/MiniCivVI_SmallerMaps.sql</File>
        <File>MiniCivVI.dep</File>
        <File>Scenarios/Sumeria/Data/SumeriaScenario_Config.xml</File>
        <File>Scenarios/Sumeria/Map/Sumeria.Civ6Map</File>
        <File>Scenarios/Sumeria/Text/en_US/SumeriaScenario_ConfigText.xml</File>
        <File>Scripts/AutomateImprovements.lua</File>
        <File>Scripts/Autoplay.lua</File>
        <File>Scripts/MiniCiv6_CivRev_Victories.lua</File>
        <File>Text/en_US/MiniCivVI_ConfigText.xml</File>
        <File>Text/MiniCivVI_CivRev_Text.sql</File>
        <File>UI/MiniCivVI_CivRev_UILogic.lua</File>
        <File>UI/MiniCivVI_CivRev_UILogic.xml</File>
        <File>UI/Replacements/BoostUnlockedPopup_Disabled.lua</File>
        <File>UI/Replacements/GovernmentScreen_MiniCivVI.lua</File>
        <File>UI/Replacements/TechCivicCompletedPopup_MiniCivVI.lua</File>
        <File>UI/Replacements/WorldRankings_CivRev.lua</File>
    </Files>
</Mod>